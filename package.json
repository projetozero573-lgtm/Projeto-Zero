{
  "name": "entre-brasil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portal editorial brasileiro com regiões, curadoria e inteligência artificial.",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test server/tests/*.test.js",
    "db:seed": "node server/seed.js",
    "test:e2e": "playwright test",
    "admin:password": "node server/admin-password.js",
    "format": "prettier --write src server tests *.js *.json index.html",
    "format:check": "prettier --check src server tests *.js *.json index.html"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
